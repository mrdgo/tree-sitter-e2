  "grammars": [
    {
      "name": "e2",
      "camelcase": "E2",
      "title": "E2",
      "scope": "source.e2",
      "file-types": [
        "e2"
      ],
      "injection-regex": "^e2$",
      "class-name": "TreeSitterE2"
    }
  ],
  "metadata": {
