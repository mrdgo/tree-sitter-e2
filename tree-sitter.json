        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/mrdgo/tree-sitter-e2",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
